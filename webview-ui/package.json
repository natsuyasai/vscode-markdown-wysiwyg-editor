{
  "name": "webview-ui",
  "version": "1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "build:debug:watch": "tsc && vite build --sourcemap \"inline\" --minify false --mode \"development\" --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:story": "vitest run --project storybook",
    "test:property": "vitest run --project unit property.spec",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-types": "tsc --build",
    "lint": "eslint ./ && npm run markuplint",
    "markuplint": "markuplint \"./src/**/*.{jsx,tsx}\""
  },
  "dependencies": {
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/utils": "^7.23.0",
    "@vscode/codicons": "^0.0.45",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.3.0",
    "node-diff3": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@markuplint/jsx-parser": "^5.6.1",
    "@markuplint/react-spec": "^5.6.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-onboarding": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.6.7",
    "fast-check": "^4.10.3",
    "jsdom": "^29.0.1",
    "markuplint": "^5.6.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.8",
    "prettier": "^3.10.1",
    "quickpickle": "^1.11.2",
    "sass": "^1.108.2",
    "storybook": "^10.6.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
